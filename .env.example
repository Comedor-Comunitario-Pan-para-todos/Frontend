# Variables de entorno del frontend. Copiar a `.env.local` (no se versiona)
# para sobrescribir valores en tu máquina.

# Base de las peticiones a la API. Ruta relativa (recomendado: la resuelve el
# proxy de Vite en desarrollo y el proxy inverso en producción) o URL completa.
VITE_API_BASE_URL=/api

# "true" para que MSW responda las peticiones en el navegador (sin backend).
# Nunca en producción: la app no arranca si se activa en un build de producción.
VITE_USAR_MOCKS=false

# --- Solo para el servidor de desarrollo (no llegan al bundle) ---

# Backend al que el proxy de Vite reenvía las peticiones a VITE_API_BASE_URL.
# Solo aplica si VITE_API_BASE_URL es una ruta relativa.
API_PROXY_TARGET=http://localhost:3000

# "true" quita el prefijo (/api) antes de reenviar, mientras el backend no
# tenga ese prefijo global. "false" lo conserva.
API_PROXY_QUITAR_PREFIJO=true
