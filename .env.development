# Valores de `pnpm dev`. Para apuntar a otro backend sin tocar este archivo,
# crea `.env.development.local` (no se versiona) con tu propio API_PROXY_TARGET.

VITE_API_BASE_URL=/api
VITE_USAR_MOCKS=false

# Backend al que el proxy de Vite reenvía las peticiones a /api.
API_PROXY_TARGET=http://localhost:3000
# "true" mientras el backend no tenga el prefijo global /api.
API_PROXY_QUITAR_PREFIJO=true
